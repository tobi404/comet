/target
**/*.rs.bk
# Local-only scratch space — holds signing/notary credentials, never commit.
/ignore/
*.pdb
.DS_Store
.env
.env.local
node_modules
.wrangler
build/
edge/dist/
# Xcode per-user state (window layout, breakpoints, scheme selection) —
# written on every open of apps/ios, never shared.
xcuserdata/
